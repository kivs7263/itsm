# ITSM 환경변수 예시
# 실제 .env 파일을 생성하고 아래 값을 채우세요.
# .env 파일은 절대 git에 커밋하지 마세요.

# ── DB ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=itsm_secure_password

# ── 인증/시크릿 ──────────────────────────────────────────────────
SECRET_KEY=change_me_random_32_chars
# SA/GW/ITSM 공유 크로스앱 시크릿 (SA, GW .env의 SERVICE_BUS_SECRET과 동일값)
SERVICE_BUS_SECRET=shared_secret_same_as_sa_gw

# ── Keycloak (선택) ───────────────────────────────────────────────
# KEYCLOAK_ISSUER=https://auth.example.com/realms/myrealm
# KEYCLOAK_CLIENT_ID=itsm

# ── Redis ─────────────────────────────────────────────────────────
# REDIS_URL은 docker-compose.yml에서 고정값 사용

# ── Meilisearch ───────────────────────────────────────────────────
MEILISEARCH_API_KEY=meilisearch_master_key

# ── MinIO ─────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret

# ── 앱 URL 연동 (프론트엔드 빌드 시 주입) ────────────────────────
NEXT_PUBLIC_ITSM_URL=http://localhost:8890
NEXT_PUBLIC_SA_URL=http://localhost:8080
NEXT_PUBLIC_GW_URL=http://localhost:8888
# NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:8443
# Cross-subdomain 쿠키 공유 — SA/GW와 동일 도메인 사용 (예: .apistech.co.kr)
# 미설정 시 itsm.apistech.co.kr에만 쿠키 설정되어 crossapp SSO 실패
NEXT_PUBLIC_COOKIE_DOMAIN=
COOKIE_DOMAIN=

# ── 외부 서비스 연동 ─────────────────────────────────────────────
# SA_API_URL=http://sa_backend:8000          (service_mesh 내부)
# GW_API_URL=http://gw_backend:8000          (service_mesh 내부)
#
# GW 결재(approval) bridge — 미설정 시 gw_approval_service가 전 함수 graceful None 반환.
#   → 이 경우 티켓/CR의 gw_approval_status가 항상 "gw_not_configured"로 고착되고
#     "결재 필요" 정책이 실제로 아무것도 막지 않으므로, 결재 연동을 쓰려면 반드시 설정.
# GW_BACKEND_URL=http://gw_backend:8000       # GW 결재 API 베이스 (service_mesh 내부)
# KC_TOKEN_URL=http://keycloak:8080/realms/platform/protocol/openid-connect/token
# KC_SERVICE_CLIENT_ID=itsm-svc               # KC 서비스 계정 client_id (기본값 itsm-svc)
# KC_SERVICE_CLIENT_SECRET=                   # KC 서비스 계정 secret (미설정 시 토큰 발급 실패)
# Calendar Service 연동 — 미설정 시 캘린더 push 비활성 (graceful skip)
# cal_nginx 컨테이너 내부 포트 80 사용 (호스트 포트 8889 아님)
CALENDAR_SERVICE_URL=http://cal_nginx

# ── 이메일 채널 수신 (IMAP 폴링) ─────────────────────────────────
# 미설정 시 email_worker 비활성 (graceful sleep)
# IMAP_HOST=mail.example.com
# IMAP_PORT=993
# IMAP_USER=itsm@example.com
# IMAP_PASSWORD=your_imap_password
# IMAP_FOLDER=INBOX
# IMAP_TENANT_SLUG=your-tenant-slug   # 수신 메일을 어느 테넌트 티켓으로 생성할지
# EMAIL_INTERVAL_SECONDS=60

# ── 카카오 알림톡 ────────────────────────────────────────────────
# 미설정 시 카카오 채널 비활성 (graceful skip)
# KAKAO_API_KEY=your_kakao_biz_api_key
# KAKAO_SENDER_KEY=your_kakao_sender_profile_key

# ── SMS (Solapi) ──────────────────────────────────────────────────
# 미설정 시 SMS 채널 비활성 (graceful skip)
# SMS_API_KEY=your_solapi_api_key
# SMS_API_SECRET=your_solapi_api_secret
# SMS_FROM_NUMBER=01012345678    # 발신번호 (010-xxxx-xxxx 형식 아닌 숫자만)

# ── OpenAI (KB 시맨틱 검색) ──────────────────────────────────────
# 미설정 시 /kb/search/semantic → 503 (graceful fallback)
# OPENAI_API_KEY=sk-...

# ── Slack / Teams 웹훅 알림 ──────────────────────────────────────
# 미설정 시 해당 채널 알림 비활성 (graceful skip)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx

# CSRF Double-Submit 보호 (RA-S4). production=true 권장, 개발 편의 시 비움
CSRF_ENFORCE=true
